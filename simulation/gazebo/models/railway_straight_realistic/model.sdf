<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="railway_straight_realistic">
    <static>true</static>
    <link name="track">
      <!-- Convert the source Y-up GLB to Gazebo Z-up, then place its lower bound on Z=0. -->
      <visual name="straight_track_visual">
        <pose>0 0 0.185822 1.57079632679 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://railway_straight_realistic/meshes/straight_track.glb</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
