<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="mono_cam">
    <self_collide>false</self_collide>
    <static>false</static>
    <link name="camera_link">
      <inertial>
        <pose>0.03 0 0 0 0 0</pose>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.00004</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00004</iyy><iyz>0</iyz><izz>0.00004</izz>
        </inertia>
      </inertial>
      <visual name="housing">
        <geometry><box><size>0.02 0.04 0.04</size></box></geometry>
      </visual>
      <visual name="lens">
        <pose>0.015 0 0 0 1.57079632679 0</pose>
        <geometry><cylinder><radius>0.008</radius><length>0.01</length></cylinder></geometry>
      </visual>
      <sensor name="imager" type="camera">
        <gz_frame_id>camera_link</gz_frame_id>
        <camera>
          <horizontal_fov>1.91986217719</horizontal_fov>
          <image><width>640</width><height>480</height></image>
          <clip><near>0.1</near><far>200</far></clip>
          <save enabled="true"><path>/tmp/uav_demo_camera</path></save>
        </camera>
        <always_on>true</always_on>
        <update_rate>5</update_rate>
        <visualize>false</visualize>
      </sensor>
      <gravity>true</gravity>
    </link>
  </model>
</sdf>
